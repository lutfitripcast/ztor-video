{
  // Option 5B, Phase A. Free plan only. See ../BUILD_PLAN.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ztor-video",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "89a040897539ed3a26aad722df127442",
  "observability": { "enabled": true },

  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  "r2_buckets": [
    { "binding": "MASTERS", "bucket_name": "ztor-masters" },
    { "binding": "STREAMS", "bucket_name": "ztor-streams" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "ztor-video", "database_id": "1581aa2b-8a17-4e4f-ad56-ad9be092b671", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "KEYS", "id": "c4b93b65a7674bfe8d2cd40c6141ac46" }
  ],
  "workflows": [
    { "name": "encode-film", "binding": "ENCODE_FILM", "class_name": "EncodeFilmWorkflow" }
  ],
  // Watch party (2026-09-24): one Durable Object per party. SQLite-backed classes are the ones the Free plan allows.
  "durable_objects": { "bindings": [{ "name": "PARTY", "class_name": "PartyRoom" }] },
  "migrations": [{ "tag": "party-v1", "new_sqlite_classes": ["PartyRoom"] }],
  // Step 8: 10 license requests per minute per user.
  "unsafe": {
    "bindings": [
      { "name": "LICENSE_RL", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
    ]
  },
  "vars": {
    "R2_ACCOUNT_ID": "89a040897539ed3a26aad722df127442",
    "MASTERS_BUCKET": "ztor-masters",
    "STREAMS_BUCKET": "ztor-streams",
    "PART_SIZE_MB": "100",
    "JWT_TTL_S": "14400",
    "KEY_SCHEME": "cbcs",
    "LICENSE_RATE_LIMIT": "0",   // step 8 says 10 per minute per viewer; 0 = disabled for testing (2026-09-24). Re-enable before launch.,
    "TEST_MODE": "true",
    "DRM_VENDOR": "axinom",
    "DRM_LICENSE_URL_WIDEVINE": "https://af7427b7.drm-widevine-licensing.axprod.net/AcquireLicense",
    "DRM_LICENSE_URL_PLAYREADY": "https://af7427b7.drm-playready-licensing.axprod.net/AcquireLicense",
    "DRM_LICENSE_URL_FAIRPLAY": "https://af7427b7.drm-fairplay-licensing.axprod.net/AcquireLicense",
    "DRM_FAIRPLAY_CERT_URL": "https://tools.axinom.com/FPScert/fairplay.cer",
    "REALTIME_APP_ID": "2ed55f309dc460453ab0b9157b6496c2"     // watch party: Realtime SFU app id (dashboard > Realtime > Serverless SFU). Empty = rtc routes answer 503; chat and sync still work.
  }
  // Secrets (wrangler secret put): JWT_SECRET, RUNNER_TOKEN, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, REALTIME_APP_SECRET (watch party), TURN_KEY_API_TOKEN (optional, with TURN_KEY_ID var)
}
